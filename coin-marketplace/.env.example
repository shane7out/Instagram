# Copy to .env.local and fill in for production.

# Public site URL (used for canonical URLs, sitemap, JSON-LD).
# Also settable in src/lib/site.ts.
NEXT_PUBLIC_SITE_URL=https://christensencoins.com

# --- Source adapters (optional, for live imports) ---
# Add per-source API keys / cookies here as you implement live adapters.
# HERITAGE_API_KEY=
# EBAY_APP_ID=
# GREATCOLLECTIONS_API_KEY=

# --- Payments: Stripe Checkout ---
# Create a free account at https://stripe.com, then paste your keys here.
# Get them at https://dashboard.stripe.com/apikeys (use test keys sk_test_...
# until you're ready to go live, then swap in live keys sk_live_...).
# When STRIPE_SECRET_KEY is set, the "Buy This Coin" button runs real checkout;
# when it's empty, the button falls back to the reserve/call flow.
STRIPE_SECRET_KEY=
# Webhook signing secret from https://dashboard.stripe.com/webhooks
# (point a webhook at https://YOUR-DOMAIN/api/webhook, event
# checkout.session.completed). Enables order fulfillment automation.
STRIPE_WEBHOOK_SECRET=

# --- Lead capture (sell form) ---
# LEADS_WEBHOOK_URL=
